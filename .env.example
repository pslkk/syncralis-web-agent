# `node --env-file=.env bin/cli.js`.

# Minimum trust score (0-100) to auto-act (click/download) without asking. Lower = more autonomous, less safe.
SYNCRALIS_WEB_AGENT_TRUST_THRESHOLD=80

# Where verified downloads are saved.
SYNCRALIS_WEB_AGENT_DOWNLOAD_DIR=

# Max download size in bytes (default 50MB).
SYNCRALIS_WEB_AGENT_MAX_DOWNLOAD_BYTES=52428800

# Extra domains to always trust, comma-separated.
SYNCRALIS_WEB_AGENT_EXTRA_ALLOWLIST=

# Max parallel sub-agents in research_query.
SYNCRALIS_WEB_AGENT_CONCURRENCY=4

# Respect robots.txt (recommended: true).
SYNCRALIS_WEB_AGENT_RESPECT_ROBOTS_TXT=true

# Per-domain requests per minute before the agent backs off.
SYNCRALIS_WEB_AGENT_RATE_LIMIT_PER_DOMAIN_PER_MIN=20

# Circuit breaker: consecutive failures before pausing a domain, and cooldown.
SYNCRALIS_WEB_AGENT_CB_FAILURE_THRESHOLD=5
SYNCRALIS_WEB_AGENT_CB_COOLDOWN_MS=300000

# Structured audit log file (JSON Lines). Always also logged to stderr.
SYNCRALIS_WEB_AGENT_AUDIT_LOG_PATH=

# Redact query text in logs (useful if queries may contain sensitive info).
SYNCRALIS_WEB_AGENT_REDACT_QUERIES_IN_LOGS=false

# DANGER: only for testing against your own internal/staging targets.
SYNCRALIS_WEB_AGENT_ALLOW_PRIVATE_NETWORK_TARGETS=false

# DANGER: allow downloading macro-enabled Office formats (.docm/.xlsm/.pptm/
# .xlsb/.dotm/.xltm/.potm). These can run embedded VBA code on open and are
# a common real-world malware vector, so they're refused by default.
SYNCRALIS_WEB_AGENT_ALLOW_MACRO_OFFICE_DOWNLOADS=false

# DANGER: allow downloading files whose extension has no defined file-
# signature check (i.e. can't be verified as genuinely matching its claimed
# type). Plain-text formats (.txt/.csv/.json/.xml/.md) are always allowed
# regardless of this flag. Off by default: unverifiable files are refused.
SYNCRALIS_WEB_AGENT_ALLOW_UNVERIFIED_EXTENSIONS=false

# DANGER: allow click_on_page/download_file to interact with an element that
# is visually hidden from a human (near-zero opacity, off-screen, clipped,
# or text colored to match its background) even though it matched
# matchText/selector and passed Playwright's basic DOM-visibility check.
# Off by default: this is refused, since a real page has no legitimate
# reason to make the exact element an agent is told to click invisible to
# the person who's supposedly using it.
SYNCRALIS_WEB_AGENT_ALLOW_CLICK_ON_VISUALLY_HIDDEN_ELEMENTS=false

# --- Web Bot Auth (RFC 9421 HTTP Message Signatures, Ed25519) ---
# Optional, off by default. When set, this agent signs its own outbound
# navigation requests so sites that support Web Bot Auth can cryptographically
# identify it as a known, honestly-declared agent rather than an anonymous
# scraper. This is about THIS agent proving ITS OWN identity outbound — it
# does not verify or trust anything about the sites it visits.
# Signing only activates once BOT_AUTH_AGENT_URL is set, because an
# unverifiable signature (no directory for a site to check it against) can
# look MORE suspicious than no signature at all.
#
# Set this to the https:// URL where you will publish the JSON produced by
# buildDirectoryDocument() (see src/security/webBotAuth.js) at
# <that-url>/.well-known/http-message-signatures-directory, so sites can
# resolve this agent's public key and verify its signed requests.
#SYNCRALIS_WEB_AGENT_BOT_AUTH_AGENT_URL=https://your-domain.example
#
# Where the agent's own Ed25519 identity keypair is persisted (generated
# once, reused across restarts). Defaults to ~/.syncralis-web-agent/keys.
# The private key file is written with owner-only (0600) permissions.
#SYNCRALIS_WEB_AGENT_BOT_AUTH_KEY_DIR=/absolute/path/to/keys

# --- Local adaptive trust memory ---
# When a user explicitly confirms or rejects a staged (below-threshold)
# click/download via confirm_action/reject_action, that decision is recorded
# locally per-domain. Enough repeated explicit CONFIRMATIONS can eventually
# raise a domain to the auto-approve threshold (never past it, and never for
# a domain the heuristic scorer hard-flagged, e.g. a typosquat); a single
# REJECTION immediately blocks any such promotion for a cooldown period,
# regardless of how many prior confirmations exist. On by default; disable
# for deployments that require fully stateless, heuristic-only behavior.
SYNCRALIS_WEB_AGENT_TRUST_MEMORY_ENABLED=true

# Where the trust-memory JSON store is persisted. Defaults to
# ~/.syncralis-web-agent/trust-memory.json.
#SYNCRALIS_WEB_AGENT_TRUST_MEMORY_PATH=/absolute/path/to/trust-memory.json

# How many explicit confirmations a domain needs before it can be promoted.
SYNCRALIS_WEB_AGENT_TRUST_MEMORY_MIN_CONFIRMATIONS=5

# A promotion expires if the most recent confirmation is older than this
# many days (the domain simply reverts to normal heuristic scoring/asking
# again — nothing is deleted).
SYNCRALIS_WEB_AGENT_TRUST_MEMORY_MAX_AGE_DAYS=90

# After an explicit rejection, promotion is blocked for this many days
# regardless of confirmation count.
SYNCRALIS_WEB_AGENT_TRUST_MEMORY_REJECTION_COOLDOWN_DAYS=30

# Outbound HTTP/HTTPS proxy for the browser (e.g. http://proxy.company.com:8080).
SYNCRALIS_WEB_AGENT_HTTP_PROXY=

# X (Twitter) API v2 bearer token — enables reliable official-API reads in fetch_updates.
SYNCRALIS_WEB_AGENT_X_BEARER_TOKEN=

# Instagram Graph API token + your connected Business/Creator account ID —
# enables Business Discovery reads of other public Business/Creator accounts.
SYNCRALIS_WEB_AGENT_INSTAGRAM_GRAPH_TOKEN=
SYNCRALIS_WEB_AGENT_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# VirusTotal API key — enables an extra hash-reputation check on downloads.
SYNCRALIS_WEB_AGENT_VIRUSTOTAL_API_KEY=

# Per-navigation timeout in ms.
SYNCRALIS_WEB_AGENT_NAVIGATION_TIMEOUT_MS=20000

SYNCRALIS_WEB_AGENT_WEB_SEARCH_PROVIDER=auto

# Tavily API key — https://tavily.com (has a free tier).
SYNCRALIS_WEB_AGENT_TAVILY_API_KEY=

# Brave Search API key — https://brave.com/search/api (has a free tier).
SYNCRALIS_WEB_AGENT_BRAVE_API_KEY=

# Per-request timeout for the search API call, in ms.
SYNCRALIS_WEB_AGENT_WEB_SEARCH_TIMEOUT_MS=10000

# Retries on transient failures (429/5xx/network/timeout) with exponential
# backoff + jitter before giving up on a provider.
SYNCRALIS_WEB_AGENT_WEB_SEARCH_MAX_RETRIES=2

# Safe-search level passed to the provider: off | moderate | strict.
SYNCRALIS_WEB_AGENT_WEB_SEARCH_SAFE_SEARCH=moderate

# DANGER / legacy: only enable if you have no outbound access to Tavily/Brave.
# defenses — treat it as a degraded, best-effort last resort, not a fix.
SYNCRALIS_WEB_AGENT_ALLOW_LEGACY_BROWSER_SEARCH_FALLBACK=false
